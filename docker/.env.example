# Copy to .env next to compose.yaml and edit.

# Airport (must be in airports.json, or mount your own /etc/toganomon.toml)
TOGANOMON_ICAO=RJFF

# Receiver position for readsb (decimal degrees, metres above sea level)
FEEDER_LAT=33.5859
FEEDER_LON=130.4510
FEEDER_ALT_M=10
FEEDER_TZ=Asia/Tokyo

# Where ultrafeeder gets Beast data from (a receiver's Beast output port)
BEAST_HOST=192.0.2.10
BEAST_PORT=30005

# Port of the console on this host
WEB_PORT=8080
